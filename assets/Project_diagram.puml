@startuml Project
hide methods
skinparam ArrowFontSize 14

entity Workspace {
    - id: UUID
    - name: String
    - description: String
    - ownerUserId: UUID
    - createdAt: LocalDateTime
}

entity Board {
    - id: UUID
    - name: String
    - description: String
    - createdAt: LocalDateTime
}

entity Invitation {
    - id: UUID
    - senderUserId: UUID
    - recipientUserId: UUID
    - message: String
    - sendedAt: LocalDateTime
    - acceptedAt: LocalDateTime
}

entity Member {
    - id: UUID
    - userId: UUID
    - joinedAt: LocalDateTime
    - active: boolean
}

enum Role {
    ADMIN
    MEMBER
    VIEWER
}

enum Status {
    ACCEPTED
    REJECTED
    UNCONFIRMED
}

entity Operation {
  - id: UUID <<not generated>>
  'Datos necesarios
  - boardId: UUID
  - userId: UUID
  - invitationId: UUID
  'Se utiliza Boolean para poder establecer el valor "null" aparte de true o false
  - memberActive: Boolean
  'Ambos son de tipo entero, no pueden ser "null"
  - manualAttempts: int
  - automaticAttempts: int
  - nextAutomaticAttemptAt: LocalDateTime
  - completedAt: LocalDateTime
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
}

enum OperationType {
  ACCEPT_INVITATION
  CHANGE_ROLE_MEMBER
  DEACTIVATE_MEMBER
  CREATE_BOARD
  DELETE_BOARD
  DELETE_WORKSPACE
}


enum OperationStatus {
  REGISTERED
  EXECUTION_PENDING
  EXECUTING
  COMPLETED
  COMPENSATION_PENDING
  LOCAL_COMPENSATION_IN_PROGRESS
  LOCAL_COMPENSATION_COMPLETED
  COMPENSATION_COMPLETED
  MANUAL_INTERVENTION_REQUIRED
}

Workspace "1 " *-- "0..*" Board
Board " 1  " *-- "0..*   " Member
Board "1  " *-- "0..*" Invitation
Member "0..*" --> "1  " Role
Invitation "0..*  " --> "1     " Role
Invitation "0..*" --> "1 " Status

Operation "0..*   " --> "1 " OperationType
Operation "0..*" --> "1 " OperationStatus
Operation "0..*" ----> "       1  " Role

@enduml