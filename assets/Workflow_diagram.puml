@startuml Workflow
hide methods
skinparam ArrowFontSize 14

' =========================================================
' Datos provenientes indirectamente de PROJECT
' =========================================================

' OWNER representa al usuario administrador del workspace.
'
' boardId hace referencia a un board administrado por
' PROJECT. No es una FK hacia una entidad Board de TASK.
enum Role {
  + OWNER
  + ADMIN
  + MEMBER
  + VIEWER
}

entity BoardAccess {
  - id: UUID
  - userId: UUID
  - userActive: boolean
  'Estado del permiso de acceso
  - status: boolean
  - role: Role
  - board: Board
}


'El ID de la entidad Board no es generado automaticamente, se
'toma el ID del Board generado en el microservicio Project, es
'por ello que se coloca <<not generated>>
entity Board {
  - id: UUID <<not generated>>
  - status: boolean
  - boardAccesses: List<BoardAccess>
  - tasks: List<Task>
  - label: List<Label>
}


' =========================================================
' Entidades propias de WORKFLOW
' =========================================================

'El valor por defecto del estado es PENDING
enum Status {
  + PENDING 
  + ON_HOLD
  + IN_PROGRESS
  + UNDER_REVIEW
  + COMPLETED
}

entity Task {
  - id: UUID
  - name: String
  - description: String
  - createdByUserId: UUID
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
  - status: Status
  - board: Board
  - labels: Set<Label>
  - notes: List<Notes>
  - histories: List<History>
}

entity Label {
  - id: UUID,
  - content: String
  - color: Color
  - board: Board
}

'Cada uno de sus valores contienen 2 atributos
enum Color {
  + RED : ("Rojo", "#FFC9C9")
  + ORANGE : ("Naranja", "#FFD6A7")
  + YELLOW : ("Amarillo", "#FFF085")
  + GREEN : ("Verde", "#D8F999")
  + EMERALD : ("Esmeralda", "#A4F4CF")
  + AQUAMARINE : ("Aguamarina", "#96F7E4")
  + SKY : ("Celeste", "#A2F4FD")
  + BLUE : ("Azul", "#B8E6FE")
  + VIOLET : ("Violeta", "#C6D2FF")
  + LILAC : ("Lila", "#DDD6FF")
  + PINK : ("Rosa", "#FCCEE8")
  + GRAY : ("Gris", "#E2E8F0")
  __ Attributes __
  - name: String
  - hex: String
}

enum OperationStatus {
  + CREATED
  + PENDING
  + PROCESSING
  + COMPLETED
}

enum OperationType {
  + ADD_BOARD_ACCESS
  + ACTIVATE_BOARD_ACCESS
  + CHANGE_ROLE_BOARD_ACCESS
  + DEACTIVATE_BOARD_ACCESS
  + ADD_BOARD_AND_BOARD_ACCESS_USER_OWNER
  + DELETE_BOARD_AND_BOARD_ACCESSES
  + DELETE_ALL_BOARDS_AND_MULTIPLE_BOARD_ACCESSES
}

entity Note {
  - id: UUID
  - content: String
  - createdByUserId: UUID
  - createdAt: LocalDateTime
  - task: Task
}


' Historial de estados de Task.
' Al crear una Task, se crea también su primer History.

entity History {
  - id: UUID
  - userId: UUID
  - createdAt: LocalDateTime
  - status: Status
  - task: Task
}


'Operaciones realizadas
entity Operation {
  - id: UUID <<not generated>>
  - boardId: UUID
  - userId: UUID
  - oldUserActive: Boolean
  - oldRole: Role
  - newRole: Role
  - boardIds: List<UUID> <<JSON>>
  - type: OperationType
  - status: OperationStatus
  'El número de intentos se mide por cantidad y no por tipo de intentos: automatico o manual
  - attempts: int
  - createdAt: LocalDateTime
  - completedAt: LocalDateTime
  - updatedAt: LocalDateTime
}


' =========================================================
' Relaciones
' =========================================================
'Una tarea puede tener ninguno, 1 o varios labels diferentes
Task "0..*  " -- "0..*  " Label
Task "1 " *-- "0..*     " Note
Task "1 " *-- " 1..*" History
Task "0..*" --> "1  " Status
History " 0..*  " --> " 1  " Status

Board "1"*---" 1..* " BoardAccess
Board "1   " *-- "0..*   " Task
BoardAccess "0..*"-up-> "1  " Role

Board " 1 " *-- "0..*" Label

Label "0..*" --> " 1" Color
 
Operation "0..*" --> "1   " OperationType
Operation "0..*" --> "1 " OperationStatus
Operation "0..* " --> "1" Role
Operation "0..* " --> "1" Role



@enduml